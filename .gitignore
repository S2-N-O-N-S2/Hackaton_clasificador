htmlcov/

# ===== Node / Vite =====
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*

# ===== Datos y modelos (pesados; compartir por USB / unidad compartida) =====
backend/models/*
!backend/models/README.md
# Las versiones entrenadas (models/v1, v2…) sí se suben: pesan ~350 KB y así la laptop de la demo
# no tiene que reentrenar (se activan con tools/registrar_modelo.py). La caché de embeddings sigue fuera.
!backend/models/v[0-9]*/
backend/captures/*
!backend/captures/README.md
# Fotos del dataset: SÍ van en git (para jugar la práctica con fotos en cualquier computadora).
# Las de _por_verificar no, porque el operador todavía no aprueba su etiqueta.
backend/dataset/_por_verificar/**/*.jpg
backend/dataset/_por_verificar/**/*.jpeg
backend/dataset/_por_verificar/**/*.png
backend/training/cache/
*.npy
*.h5
*.keras
*.joblib
*.pkl
*.zip
# ...salvo los de las versiones entrenadas (ver arriba)
!backend/models/v[0-9]*/*.joblib
!backend/models/v[0-9]*/*.keras

